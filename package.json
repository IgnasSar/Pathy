{
  "name": "pathy",
  "private": true,
  "version": "0.1.0",
  "description": "Pathy monorepo",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm run build:shared && concurrently --names web,api --prefix-colors cyan,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --dir packages/web dev",
    "dev:api": "pnpm --dir packages/api dev",
    "build:web": "pnpm --dir packages/web build",
    "build:api": "pnpm --dir packages/api build",
    "build:shared": "pnpm --dir packages/shared build",
    "build": "pnpm run build:shared && pnpm run build:api && pnpm run build:web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck:web": "pnpm --dir packages/web typecheck",
    "typecheck:api": "pnpm --dir packages/api typecheck",
    "typecheck:shared": "pnpm --dir packages/shared typecheck",
    "typecheck:tests": "pnpm --dir packages/api exec tsc -p ../../tests/tsconfig.json --noEmit",
    "typecheck": "pnpm run typecheck:shared && pnpm run typecheck:api && pnpm run typecheck:web && pnpm run typecheck:tests",
    "cypress:run": "cypress run --component --headed",
    "test": "vitest run",
    "test:baseline": "vitest run baseline.test --coverage --coverage.reportsDirectory=coverage/baseline",
    "test:llm": "vitest run llm.test --coverage --coverage.reportsDirectory=coverage/llm",
    "test:coverage": "pnpm test:baseline && pnpm test:llm",
    "metrics:mi": "node metrics/maintainability.mjs",
    "metrics:coupling": "depcruise packages/api/src packages/web/src packages/shared/src -c metrics/dependency-cruiser.cjs --metrics -T metrics",
    "metrics:complexity": "eslint --config metrics/complexity.mjs packages/api/src/app.ts packages/api/src/lib/mistral.ts packages/api/src/db/placesRepository.ts packages/api/src/db/savedRoutesRepository.ts packages/web/src/utils/geo.ts",
    "cypress:open": "cypress open --component",
    "scrape:pamatyklietuvoje": "node scripts/scrape-pamatyklietuvoje.mjs",
    "import:pamatyklietuvoje": "pnpm run build:shared && pnpm --dir packages/api import:pamatyklietuvoje",
    "data:refresh:pamatyklietuvoje": "pnpm scrape:pamatyklietuvoje && pnpm import:pamatyklietuvoje"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "concurrently": "^9.2.1",
    "cypress": "^16.1.1",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.5.0",
    "prettier": "^3.8.2",
    "typescript-eslint": "^8.58.2",
    "typhonjs-escomplex": "^0.1.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.5"
  }
}
